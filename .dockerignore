# Keep the build context small and free of secrets / local state.
.git
.github
.gitignore
.dockerignore
.venv
venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
.coverage
htmlcov
*.log

# local databases and environment files (never bake secrets or data into the image)
*.sqlite3
*.sqlite3-journal
.env
.env.*
!.env.example

# generated at build time
staticfiles
media

# deployment manifests are not needed inside the image (only the container helpers are)
deploy/*
!deploy/docker
docker-compose*.yml
Dockerfile

# editor / OS noise
.idea
.vscode
*.swp
.DS_Store
