# Copy to .env (never commit .env) and export before running manage.py.
# For Docker Compose use deploy/compose.env.example instead; production notes: docs/DEPLOYMENT.md.
# REQUIRED. At least 50 random characters; with LINKEDEYE_DEBUG=false the console refuses to start on a shorter, repetitive
# or "change-me" key. Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
LINKEDEYE_SECRET_KEY=
LINKEDEYE_DEBUG=false
LINKEDEYE_ALLOWED_HOSTS=linkedeye.example.internal
LINKEDEYE_CSRF_TRUSTED_ORIGINS=https://linkedeye.example.internal
# Reverse proxies (IPs/CIDRs) whose X-Forwarded-For is trusted for audit source IPs and the sign-in throttle; empty = use
# the peer address. Behind a proxy or ingress set it (same peers as GUNICORN_FORWARDED_ALLOW_IPS), or every client shares
# the proxy's address and 20 wrong passwords from anyone lock the sign-in page for all users.
LINKEDEYE_TRUSTED_PROXIES=
# Sessions end after this many seconds without a request (8 hours); false = an absolute lifetime instead of an idle timeout.
# LINKEDEYE_SESSION_COOKIE_AGE=28800
# LINKEDEYE_SESSION_SAVE_EVERY_REQUEST=true
# LINKEDEYE_SECURE_COOKIES=true      # false only for plain-HTTP trials on a trusted network (deploy/live, mode http)
# LINKEDEYE_HSTS_SECONDS=0          # Strict-Transport-Security max-age; 86400 to start, 31536000 once HTTPS works
# Cookie names when multiple Django apps share a host (different ports), e.g. console + legacy API on 127.0.0.1.
# LINKEDEYE_CSRF_COOKIE_NAME=linkedeyecsrftoken
# LINKEDEYE_SESSION_COOKIE_NAME=linkedeyesessionid
# LINKEDEYE_TIME_ZONE=Asia/Kolkata
# LINKEDEYE_LOG_LEVEL=INFO

# Database: sqlite by default. For MySQL (as in LinkedEyeWebProject):
# LINKEDEYE_DB_ENGINE=django.db.backends.mysql
# LINKEDEYE_DB_NAME=linkedeye
# LINKEDEYE_DB_USER=linkedeye
# LINKEDEYE_DB_PASSWORD=
# LINKEDEYE_DB_HOST=mysql.fs-linkedeye
# LINKEDEYE_DB_PORT=31728
# LINKEDEYE_DB_CONN_MAX_AGE=60

# Tenant whose records the console shows (single-tenant deployment).
LINKEDEYE_TENANT=default
# Product chrome (optional). FinSpot overlay sets Argus LinkedEye / argus.itsm — never a third-party vendor name.
# LINKEDEYE_BRAND_VENDOR=Argus
# LINKEDEYE_BRAND_PRODUCT=LinkedEye
# LINKEDEYE_BRAND_SUITE=argus.itsm
# LINKEDEYE_BRAND_COPYRIGHT_URL=https://linkedeye.in/
# LINKEDEYE_BRAND_COPYRIGHT_LABEL=LinkedEye.in
# LINKEDEYE_BRAND_HEADLINE=One view of every site, alert and ticket.
# LINKEDEYE_BRAND_LEAD=ITSM and infrastructure monitoring for your data centres and cloud, on a Prometheus telemetry plane.

# Optional read-only status bridge to the legacy Neo4j dashboard API. Set this URL
# after deploying /dashboard/api/summary, then set the same high-entropy token in
# LINKEDEYE_BACKEND_SUMMARY_TOKEN and backend's DASHBOARD_API_TOKEN.
# LINKEDEYE_BACKEND_SUMMARY_URL=https://legacy-dashboard.example.com/dashboard/api/summary
LINKEDEYE_BACKEND_SUMMARY_URL=
LINKEDEYE_BACKEND_SUMMARY_TOKEN=

# Probes. Private/internal addresses are blocked unless listed here (SSRF guard).
# Example: NSE/BSE 10.10.0.0/16,10.20.0.0/16; FinSpot Lesites dev mgmt 172.16.0.0/16
LINKEDEYE_PROBE_ALLOWED_PRIVATE_CIDRS=
LINKEDEYE_PROBE_TIMEOUT=10
LINKEDEYE_PROBE_WORKERS=8
LINKEDEYE_PROBE_RETENTION_DAYS=30

# Notifications for critical/warning events
LINKEDEYE_NOTIFY_WEBHOOK_URLS=
LINKEDEYE_NOTIFY_EMAILS=
# LINKEDEYE_EMAIL_HOST=localhost
# LINKEDEYE_EMAIL_PORT=25
# LINKEDEYE_EMAIL_USE_TLS=false
# LINKEDEYE_EMAIL_HOST_USER=
# LINKEDEYE_EMAIL_HOST_PASSWORD=
# LINKEDEYE_EMAIL_TIMEOUT=10
# LINKEDEYE_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Severities that notify, and delivery tuning: queued in the background (ASYNC, WORKERS, QUEUE_SIZE); more than
# DIGEST_THRESHOLD events inside DIGEST_WINDOW seconds are sent as one digest.
# LINKEDEYE_NOTIFY_SEVERITIES=critical,warning
# LINKEDEYE_NOTIFY_ASYNC=true
# LINKEDEYE_NOTIFY_WORKERS=2
# LINKEDEYE_NOTIFY_QUEUE_SIZE=500
# LINKEDEYE_NOTIFY_DIGEST_THRESHOLD=10
# LINKEDEYE_NOTIFY_DIGEST_WINDOW=60
LINKEDEYE_DEFAULT_FROM_EMAIL=linkedeye@example.internal
# Welcome e-mail when admins create users (true/false). Optional public sign-in URL if not inferrable from the request.
# LINKEDEYE_WELCOME_EMAIL=true
# LINKEDEYE_PORTAL_URL=https://linkedeye.example/login
# E-mail OTP after password on console sign-in (default: on in production, off when DEBUG=true)
# LINKEDEYE_LOGIN_OTP=true
# Sign-in throttle: failures per username / per client address inside the window (minutes, also the lock-out time).
# LINKEDEYE_LOGIN_MAX_FAILURES=5
# LINKEDEYE_LOGIN_MAX_FAILURES_PER_IP=20
# LINKEDEYE_LOGIN_WINDOW_MINUTES=15

# Integrations (optional)
LINKEDEYE_PROMETHEUS_URL=
# LINKEDEYE_PROMETHEUS_TIMEOUT=8
# snmp_exporter for onboarded network devices: onboarding verifies through it and Prometheus scrapes them through it
# (/api/sd/). A private address must be in LINKEDEYE_PROBE_ALLOWED_PRIVATE_CIDRS; the Credentials step's value wins.
# e.g. http://snmp-exporter:9116
# LINKEDEYE_SNMP_EXPORTER_URL=
LINKEDEYE_ALERTMANAGER_WEBHOOK_TOKEN=
LINKEDEYE_LOG_INGEST_TOKEN=
LINKEDEYE_STACKSTORM_URL=
LINKEDEYE_STACKSTORM_API_KEY=
LINKEDEYE_NAGIOS_URL=
LINKEDEYE_NAGIOS_USER=
LINKEDEYE_NAGIOS_PASSWORD=
# LINKEDEYE_NAGIOS_TIMEOUT=10
# Credential vault (Administration > Onboarding): Fernet key(s) that encrypt stored SSH/SNMP/HTTP secrets and the
# Prometheus service-discovery token. Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Several keys may be comma-separated for rotation (the first encrypts, every one may decrypt). Without a key
# LinkedEye refuses to store a secret; there is no plaintext fallback. Back the key up apart from the database.
LINKEDEYE_CREDENTIAL_KEY=
# Onboarding: also send an exporter's HTTP login over plain http (default false: https only)
LINKEDEYE_ONBOARDING_ALLOW_CLEARTEXT_CREDENTIALS=false
# Retention in days
# LINKEDEYE_LOG_RETENTION_DAYS=14
# LINKEDEYE_TELEMETRY_ALERT_RETENTION_DAYS=90
# LINKEDEYE_TELEMETRY_ALERT_STALE_HOURS=48
# LINKEDEYE_AUTOMATION_RETENTION_DAYS=90
LINKEDEYE_INCIDENT_AUTO_CREATE=true
# Ops Agent (optional). Empty key = retrieval-only answers from live records.
# LINKEDEYE_AGENT_API_KEY=
# LINKEDEYE_AGENT_BASE_URL=https://api.openai.com/v1
# LINKEDEYE_AGENT_MODEL=gpt-4o-mini
# LINKEDEYE_AGENT_EMBEDDING_MODEL=text-embedding-3-small
# LINKEDEYE_AGENT_TIMEOUT=30
# LINKEDEYE_AGENT_TURNS_PER_MINUTE=20
# LINKEDEYE_AGENT_RETENTION_DAYS=90
# APM (adapter matrix, process status, execution logs from the cron toolkit): days of history and of logs kept.
# Reading the toolkit's Redis keys from LinkedEye is optional and needs the redis package: build the image with
# LINKEDEYE_DB_EXTRAS="postgres apm" or `pip install -r requirements-apm.txt` (see docs/APM.md).
# LINKEDEYE_APM_RETENTION_DAYS=30
# LINKEDEYE_APM_LOG_RETENTION_DAYS=7
# Scheduler (manage.py run_probes): one active instance per database; a standby takes over when the lease expires.
# LINKEDEYE_SCHEDULER_LEASE=true
# LINKEDEYE_SCHEDULER_LEASE_TTL=90
# LINKEDEYE_SCHEDULER_HEARTBEAT_SECONDS=30
# LINKEDEYE_SCHEDULER_PASS_BUDGET=60
# LINKEDEYE_SCHEDULER_CRITICAL_JOBS=tcpcheck.run_due,servicedesk.sla
# Server hardware over Redfish (Dell iDRAC, HPE iLO), read-only (docs/HARDWARE.md). BMCs are usually on private addresses:
# list their range in LINKEDEYE_PROBE_ALLOWED_PRIVATE_CIDRS or the poll is refused by the network policy.
# LINKEDEYE_HARDWARE_READING_RETENTION_DAYS=7   (sensor readings; older than a day are thinned to one per 10 minutes)
# LINKEDEYE_HARDWARE_EVENT_RETENTION_DAYS=90
# LINKEDEYE_HARDWARE_POLL_WORKERS=4
# Hypervisor (vCenter, read-only): days of VM events kept, days a VM / host / datastore that vCenter no longer lists is kept,
# days a control request may wait for a decision, and whether the sync may overwrite compute VM placement values an operator
# typed by hand (default false). Snapshots and event history need the optional pyvmomi package:
# LINKEDEYE_DB_EXTRAS="postgres vsphere" or `pip install -r requirements-vsphere.txt` (see docs/HYPERVISOR.md).
# The vCenter address must be allowed by the probe policy: LINKEDEYE_PROBE_ALLOWED_PRIVATE_CIDRS for a private range.
# LINKEDEYE_HYPERVISOR_EVENT_RETENTION_DAYS=30
# LINKEDEYE_HYPERVISOR_MISSING_DAYS=30
# LINKEDEYE_HYPERVISOR_REQUEST_TTL_DAYS=7
# LINKEDEYE_HYPERVISOR_OVERWRITE_PLACEMENT=false
# The /legacy/ design mock-ups (fabricated sample data) answer 404 unless this is true. Leave it off on a live console (docs/LIVE_DATA.md).
# LINKEDEYE_SHOW_SAMPLE_PAGES=false
