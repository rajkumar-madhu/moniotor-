# LinkedEye Environment Variables (Vault-first)
# Copy to .env in project root (next to manage.py)
# Keep only Vault bootstrap/connectivity values in .env.
# All app config/secrets should live in Vault bundle: secret/linkedeye/app

VAULT_APP_SECRETS_ENABLED=true
VAULT_APP_SECRETS_PATH=secret/linkedeye/app
VAULT_KV_VERSION=2

VAULT_SCHEME=http
VAULT_HOST=vault.fs-linkedeye
VAULT_PORT=8200

# Authentication to Vault (choose one)
# 1) Dev/bootstrap token
# VAULT_TOKEN=

# 2) AppRole (recommended for long-running deployments)
# VAULT_APP_ROLE_ID=
# VAULT_APP_SECRET_ID=

# Optional cache TTL for Vault bundle reads
VAULT_SECRETS_CACHE_TTL=300

# Seed all existing .env keys into Vault once:
#   python manage.py vault_seed_app_secrets --all-env

# Django runtime security controls
DJANGO_DEBUG=false
LE_ALLOWED_HOSTS=["linkedeye.finspot.in"]
LE_CORS_ALLOW_ALL=false
LE_CORS_ALLOWED_ORIGINS=["https://linkedeye.finspot.in"]
LE_CSRF_TRUSTED_ORIGINS=["https://linkedeye.finspot.in"]
LE_X_FRAME_OPTIONS=SAMEORIGIN
LE_SESSION_COOKIE_SECURE=true
LE_CSRF_COOKIE_SECURE=true
LE_SECURE_SSL_REDIRECT=true
LE_SECURE_HSTS_SECONDS=31536000
LE_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
LE_SECURE_HSTS_PRELOAD=true
LE_TRUST_X_FORWARDED_PROTO=true

# ── Hybrid Keycloak + MySQL login (SSO + fallback; see docs/KEYCLOAK_HYBRID_LOGIN.md) ──
# Interactive SSO login client:
KEYCLOAK_ENABLED=true
KEYCLOAK_SERVER_URL=https://<keycloak>
KEYCLOAK_REALM=<realm>
KEYCLOAK_CLIENT_ID=linkedeye-web
KEYCLOAK_CLIENT_SECRET=                      # store in Vault in production
PORTAL_URL=https://<portal-domain>
KEYCLOAK_ALLOWED_DOMAINS=["finspot.in"]
# Admin API client that mirrors app-onboarded users into Keycloak (service account
# with realm-management manage-users/view-users/query-users):
KEYCLOAK_ADMIN_CLIENT_ID=linkedeye-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=               # store in Vault in production
KEYCLOAK_ADMIN_SYNC_ENABLED=true
KEYCLOAK_DELETE_MODE=delete                 # 'delete' or 'disable'

# ── Monitoring auth (Grafana / Prometheus behind Keycloak oauth2-proxy) ──
# 'bearer' makes Django fetch a Keycloak client-credentials token per service and
# send it as Authorization: Bearer to the oauth2-proxy. Requires a confidential
# Keycloak client per service with Service Accounts enabled, and each
# Grafana/Prometheus oauth2-proxy started with --skip-jwt-bearer-tokens=true
# (+ matching --extra-jwt-issuers). Defaults to 'bearer' when a client secret is set.
MONITORING_AUTH_MODE=bearer
KEYCLOAK_GRAFANA_CLIENT_ID=grafana
KEYCLOAK_GRAFANA_CLIENT_SECRET=             # store in Vault in production
KEYCLOAK_PROMETHEUS_CLIENT_ID=prometheus
KEYCLOAK_PROMETHEUS_CLIENT_SECRET=          # store in Vault in production
# Only needed when the Neo4j REST host is fronted by a public oauth2-proxy
# ingress; internal cluster-only Neo4j connections ignore this entirely.
KEYCLOAK_NEO4J_CLIENT_ID=neo4j
KEYCLOAK_NEO4J_CLIENT_SECRET=                # store in Vault in production
# Only needed when the Elasticsearch host is fronted by a public oauth2-proxy
# ingress (lib/es_client.py get_secure_es_client); the internal singleton
# client ignores this entirely.
KEYCLOAK_ELASTIC_CLIENT_ID=elastic
KEYCLOAK_ELASTIC_CLIENT_SECRET=              # store in Vault in production
KEYCLOAK_MONITORING_TOKEN_URL=https://<keycloak>/realms/<realm>/protocol/openid-connect/token
# KEYCLOAK_MONITORING_SCOPE=
MONITORING_VERIFY_SSL=false
# prometheus_proxy URL rewrite (public URL -> in-cluster service). Both must be
# set to enable; leave blank to disable. Example for the mirai deployment:
# PROMETHEUS_EXTERNAL_URL=https://prometheus-prod-le.miraeassetcm.com
# PROMETHEUS_INTERNAL_URL=http://prometheus-svc:8080
# Legacy fallback (used when MONITORING_AUTH_MODE=basic):
# GRAFANA_PASSWORD=
# PROMETHEUS_PASSWORD=