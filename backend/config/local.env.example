# Local / NodePort dev cluster — copy to ../.env and replace YOUR_CLUSTER_NODE_IP.
# Do NOT commit .env with real credentials.

MYSQL_DB_NAME=linkedeye
MYSQL_DB_USER=root
MYSQL_DB_PASS=your_mysql_password
MYSQL_DB_HOST=YOUR_CLUSTER_NODE_IP
MYSQL_DB_PORT=32406

POSTGRES_USER=linkedeye
POSTGRES_PASS=your_postgres_password
POSTGRES_HOST=YOUR_CLUSTER_NODE_IP
POSTGRES_PORT=30468
POSTGRES_DB_NAME=linkedeye
POSTGRES_SUPERSET_DB=superset

NEO4J_HOST=YOUR_CLUSTER_NODE_IP
NEO4J_PORT=31105
NEO4J_USER=neo4j
NEO4J_PASS=your_neo4j_password

REDIS_HOST=YOUR_CLUSTER_NODE_IP
REDIS_PORT=32268
REDIS_PASSWORD=your_redis_password

ELASTIC_HOST=YOUR_CLUSTER_NODE_IP
ELASTIC_PORT=31545
ELASTIC_USER=elastic
ELASTIC_PASS=your_elastic_password

VAULT_SCHEME=http
VAULT_HOST=127.0.0.1
VAULT_PORT=18200
VAULT_APP_SECRETS_ENABLED=true
VAULT_APP_ROLE_ID=
VAULT_APP_SECRET_ID=

PORTAL_URL=http://127.0.0.1:8000
ANALYTICS_DASHBOARD_PREFIX_URL=https://your-analytics-dashboard/
WEBSOCKET_PREFIX_URL=
WEBSOCKET_STATS_IP=
# Shared bearer token for /dashboard/api/summary; set the same value in the console app.
DASHBOARD_API_TOKEN=

LINKEDEYE_EMAIL=eva@finspot.in
LINKEDEYE_EMAIL_APPKEY=your_office365_app_password
APPRISE_HOST=YOUR_CLUSTER_NODE_IP
APPRISE_PORT=8000

SECRET_KEY=dev-insecure-change-me
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_SITE_ID=1
GOOGLE_ALLOW_DOMAINS=["finspot.in"]
