SNMP - v3 - positive
-------------------

from LinkedEyeValidation import snmp
result = snmp(version='v3', 
              securitylevel="authPriv",
              username="testuser",
              authenticationmethod="MD5",
              authenticationpassword="testauthpass",
              privacymethod="DES",
              privacypassword="testprivpass",
              ip="172.16.0.141").check()
print(result)


