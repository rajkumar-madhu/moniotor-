# Second env-file for a full Django console on a separate Compose project (e.g. linkedeye-console).
#   docker-compose -p linkedeye-console --env-file .env --env-file deploy/compose.console.env up -d db web probes
WEB_PUBLISH=127.0.0.1:8014
LINKEDEYE_CSRF_TRUSTED_ORIGINS=http://localhost:8014,http://127.0.0.1:8014
# FinSpot lab probes (optional — or set in .env): 10.10.0.0/16,10.20.0.0/16,172.16.0.0/16
