# Second env-file for a full Django console on a separate Compose project (linkedeye-console), beside the main stack:
#   docker compose -p linkedeye-console --env-file .env --env-file deploy/compose.console.env \
#     -f docker-compose.yml -f docker-compose.console.yml up -d db web probes
# These values only fill in ${...} in the compose files. docker-compose.console.yml passes the CONSOLE_* ones to the web
# container; a LINKEDEYE_* line added here would NOT reach any container (put shared settings in .env instead).
WEB_PUBLISH=127.0.0.1:8014
# Host names the console answers to: what you type in the browser, "localhost" (container health check) and "web".
CONSOLE_ALLOWED_HOSTS=localhost,127.0.0.1,web
CONSOLE_CSRF_TRUSTED_ORIGINS=http://localhost:8014,http://127.0.0.1:8014
# Different from the main console's linkedeyecsrftoken / linkedeyesessionid: both run on the same host, and browsers
# share cookies across ports, so equal names would sign each console out of the other.
CONSOLE_CSRF_COOKIE_NAME=linkedeyeconsolecsrftoken
CONSOLE_SESSION_COOKIE_NAME=linkedeyeconsolesessionid
# FinSpot lab probes: set LINKEDEYE_PROBE_ALLOWED_PRIVATE_CIDRS=10.10.0.0/16,10.20.0.0/16 in .env (never 172.16.0.0/16: cluster API server and nodes)
# (docs/FINSPOT_DEV_K8S.md); it has no effect in this file.
