# FinSpot platform URLs and credentials (local only).
#   cp deploy/finspot-platform.env.example deploy/finspot-platform.env
# Fill deploy/finspot-platform.env — it is gitignored. Never commit real passwords.
#
# Usage:
#   set -a && source deploy/finspot-platform.env && set +a
#   echo "$HARBOR_PASSWORD" | docker login "$HARBOR_REGISTRY" -u "$HARBOR_USER" --password-stdin

HARBOR_URL=https://harbor.finspot.in
HARBOR_REGISTRY=harbor.finspot.in
HARBOR_USER=admin
HARBOR_PASSWORD=

ARGOCD_URL=https://argocd.finspot.in
ARGOCD_SERVER=argocd.finspot.in
ARGOCD_USER=admin
ARGOCD_PASSWORD=

JENKINS_URL=https://jenkins.finspot.in
JENKINS_USER=admin
JENKINS_PASSWORD=
