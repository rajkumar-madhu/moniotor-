# Environment for the live deployment pack (deploy/live/docker-compose.live.yml).
#
#   ./deploy/live/bootstrap.sh            copies this file to deploy/live/.env (mode 600), generates every blank secret,
#                                         derives the lines marked MANAGED from LINKEDEYE_DOMAIN and LINKEDEYE_MODE, and
#                                         starts the stack. You normally only edit the "who and where" and "mail" blocks.
#
# Never commit the filled-in copy: it holds the database password, the Django secret key and the credential vault key.
# Back it up together with the database (backup.sh does): without LINKEDEYE_CREDENTIAL_KEY stored credentials are unreadable.
# Compose reads this file too and interpolates a $ in unquoted values. bootstrap.sh single-quotes anything awkward when it
# writes a value for you; if you edit by hand, wrap passwords containing $, # or spaces in single quotes: PASSWORD='p$ss word'.

# ---- who and where (REQUIRED) -------------------------------------------------------------------------------------
# The name users type in the browser: a public DNS name (mode https), an IP address or internal name (mode internal),
# or localhost / a private address (mode http).
LINKEDEYE_DOMAIN=linkedeye.example.com
# https     public DNS name; Caddy gets and renews a Let's Encrypt certificate (ports 80 and 443 must be reachable)
# internal  IP address or internal name; HTTPS with a certificate from Caddy's own CA (browsers warn until you trust it)
# http      plain HTTP for localhost or a trusted network; sign-in cookies are NOT encrypted
LINKEDEYE_MODE=https
# https mode: Let's Encrypt sends certificate-expiry notices here.
LINKEDEYE_ACME_EMAIL=ops@example.com
# Host ports. Change them only when 80/443 are taken (then the public URL carries the port, and Let's Encrypt cannot work).
LINKEDEYE_HTTP_PORT=80
LINKEDEYE_HTTPS_PORT=443
# Interface the ports are published on. Blank = all interfaces. bootstrap.sh sets 127.0.0.1 when the domain is localhost.
LINKEDEYE_BIND_ADDRESS=

# ---- first administrator (used once by bootstrap.sh; the password is never stored here) ---------------------------------
# The e-mail address receives the sign-in code, so it must be a mailbox you can read.
LINKEDEYE_ADMIN_USER=admin
LINKEDEYE_ADMIN_EMAIL=admin@example.com
# The password: bootstrap.sh asks for it, or reads LINKEDEYE_ADMIN_PASSWORD from your shell, or generates one and prints it once.

# ---- secrets (bootstrap.sh generates a value for every blank line) -----------------------------------------------------
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
LINKEDEYE_SECRET_KEY=
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LINKEDEYE_DB_PASSWORD=
# Credential vault (Onboarding stores SSH / SNMP / HTTP secrets and the Prometheus login encrypted with it).
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LINKEDEYE_CREDENTIAL_KEY=
# Bearer tokens for the Alertmanager webhook (observability profile) and the log ingest API. Blank = endpoint disabled.
LINKEDEYE_ALERTMANAGER_WEBHOOK_TOKEN=
LINKEDEYE_LOG_INGEST_TOKEN=

# ---- MANAGED by bootstrap.sh from DOMAIN and MODE (re-run bootstrap.sh after changing those) ---------------------------------
LINKEDEYE_ALLOWED_HOSTS=
LINKEDEYE_CSRF_TRUSTED_ORIGINS=
LINKEDEYE_SECURE_COOKIES=
LINKEDEYE_HSTS_SECONDS=

# ---- mail: the sign-in code and notifications ------------------------------------------------------------------------------
# By default every sign-in needs a code sent by e-mail, so the console needs a working SMTP server before anyone can log in.
# Without one, bootstrap.sh refuses (modes https and internal) or switches the code off (mode http, trusted networks only).
LINKEDEYE_EMAIL_HOST=
LINKEDEYE_EMAIL_PORT=587
LINKEDEYE_EMAIL_HOST_USER=
LINKEDEYE_EMAIL_HOST_PASSWORD=
LINKEDEYE_EMAIL_USE_TLS=true
LINKEDEYE_DEFAULT_FROM_EMAIL=linkedeye@example.com
# true / false. Blank = on (the production default). false = password only: acceptable on a trusted network only.
LINKEDEYE_LOGIN_OTP=

# ---- monitoring targets and integrations ---------------------------------------------------------------------------------
# Private and loopback targets are refused unless their range is listed (SSRF guard), e.g. 10.0.0.0/8,192.168.0.0/16
LINKEDEYE_PROBE_ALLOWED_PRIVATE_CIDRS=
# Set by bootstrap.sh --observability to http://prometheus:9090; or point it at your own Prometheus.
LINKEDEYE_PROMETHEUS_URL=
LINKEDEYE_NOTIFY_WEBHOOK_URLS=
LINKEDEYE_NOTIFY_EMAILS=
LINKEDEYE_TIME_ZONE=Asia/Kolkata
LINKEDEYE_TENANT=default
# Every other LINKEDEYE_* variable of deploy/compose.env.example works here too (same names, same meaning).

# ---- compose-only knobs ------------------------------------------------------------------------------------------------------
# Image to run; bootstrap.sh builds it from this checkout and tags it with this name. Use a registry name plus --pull to
# run a prebuilt image instead.
LINKEDEYE_IMAGE=linkedeye:9.0
# Caddy image (pinned tag). Change it only to move to a newer reviewed release.
LINKEDEYE_CADDY_IMAGE=caddy:2.10.0-alpine
# Memory limits per container (raise them on a bigger host; the database is not limited).
LINKEDEYE_WEB_MEMORY=2g
LINKEDEYE_WORKER_MEMORY=1g
LINKEDEYE_APP_MEMORY=1g
LINKEDEYE_CADDY_MEMORY=512m
# Backups (backup.sh): where they go and how long they are kept.
LINKEDEYE_BACKUP_DIR=
LINKEDEYE_BACKUP_KEEP_DAYS=14
# Observability profile (bootstrap.sh --observability sets COMPOSE_PROFILES): host ports are loopback only.
COMPOSE_PROFILES=
PROMETHEUS_PUBLISH=127.0.0.1:9090
ALERTMANAGER_PUBLISH=127.0.0.1:9093
PROMETHEUS_RETENTION=15d
