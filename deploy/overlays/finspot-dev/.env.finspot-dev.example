# Local LinkedEye on VPN, aligned with deploy/overlays/finspot-dev/configmap-patch.yaml.
# Usage (repo root):
#   set -a && source deploy/overlays/finspot-dev/.env.finspot-dev && set +a
#   LINKEDEYE_DEBUG=true .venv/bin/python manage.py runserver 127.0.0.1:8014
#
# Requires: FortiClient VPN, /etc/hosts -> 172.16.0.77 for fs-le-dev1.finspot.in
# Do not commit a copy with real tokens (use .env.finspot-dev.local, gitignored).

LINKEDEYE_DEBUG=true
LINKEDEYE_ALLOWED_HOSTS=127.0.0.1,localhost,fs-le-dev1.finspot.in,fs-le-dev.finspot.in
LINKEDEYE_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8014,http://localhost:8014,https://fs-le-dev1.finspot.in,https://fs-le-dev.finspot.in

LINKEDEYE_BRAND_VENDOR=Argus
LINKEDEYE_BRAND_PRODUCT=LinkedEye
LINKEDEYE_BRAND_SUITE=argus.itsm
LINKEDEYE_BRAND_HEADLINE=One view of every site, alert and ticket.
LINKEDEYE_BRAND_LEAD=ITSM and infrastructure monitoring for FinSpot data centres and cloud, on a Prometheus telemetry plane.

LINKEDEYE_PROMETHEUS_URL=https://fs-le-dev1-prometheus.finspot.in
LINKEDEYE_PROMETHEUS_TIMEOUT=30
LINKEDEYE_PROBE_ALLOWED_PRIVATE_CIDRS=10.10.0.0/16,10.20.0.0/16,172.16.0.0/16

# Gle dashboard rings (set token from linkedeye-secrets / gle DASHBOARD_API_TOKEN)
LINKEDEYE_BACKEND_SUMMARY_URL=https://gle.finspot.in/dashboard/api/summary
LINKEDEYE_BACKEND_SUMMARY_TOKEN=
