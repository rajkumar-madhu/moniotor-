#TEMPLATE_USED:DIRECT/HOSTS/Switch/CISCO/C2960-24.j2
## Host as Service
define host {
        use 			    generic-switch
        alias 			    {{ COMMON_HOSTNAME }}
        display_name 		{{ COMMON_HOSTNAME }}
        address 		    {{ COMMON_IPADDRESS }}
	    check_command		check_ping!200.0,20%!600.0,60%
        _NEO4j_contactEmail 	{{ REUSABLE_EMAIL }}
        _NEO4j_Automation                 {{ BOOL__REUSABLE_AUTOMATION }}
        _NEO4j_Vault                 {{ REUSABLE_AUTOMATION__REUSABLE_VAULT }}
        host_name 		    {{ COMMON_HOSTNAME }}
	    _NEO4j_title 		{{ COMMON_HOSTNAME }}
        _NEO4j_contactEmail                 {{ REUSABLE_EMAIL }}
        _NEO4j_Automation                 {{ BOOL__REUSABLE_AUTOMATION }}
        _NEO4j_Vault                 {{ REUSABLE_AUTOMATION__REUSABLE_VAULT }}
        _NEO4j_hostname	    {{ COMMON_HOSTNAME }}
	    _NEO4j_address		{{ COMMON_IPADDRESS }}
        _NEO4j_nics		        {}
        _NEO4j_sertype        Exe_24stack
        _NEO4j_FrdlyName		        {{ FRNDLY_NAME }}
	_NEO4j_application	{{ GLOBAL_APPLICATION }}
	    _NEO4j_layer	e_swi
	    _NEO4j_tech	Switch
	    _NEO4j_icon		    24_stack_switch.j2
	    _NEO4j_type     Host
	    _NEO4j_parent       ""
	    _NEO4j_WF			        {}
}

## Service as Micro-Service
define service{
        use                     	generic-1min-service
	    host_name               	{{ COMMON_HOSTNAME }}
        service_description     	{{ COMMON_HOSTNAME }}:Info
        check_command           	check_snmp!-C {{CUSTOM_READ_COMMUNITY_STRING}} -o sysDescr.0 -r '2|1' -m RFC1213-MIB
        _NEO4j_title             	{{ COMMON_HOSTNAME }}:Info
        _NEO4j_contactEmail                 {{ REUSABLE_EMAIL }}
        _NEO4j_Automation                 {{ BOOL__REUSABLE_AUTOMATION }}
        _NEO4j_Vault                 {{ REUSABLE_AUTOMATION__REUSABLE_VAULT }}
        _NEO4j_parent           	{{ COMMON_HOSTNAME }}
        _NEO4j_address          	{{ COMMON_IPADDRESS }}
	_NEO4j_application	{{ GLOBAL_APPLICATION }}
	_NEO4j_layer        e_swi
        _NEO4j_tech       	Switch
        _NEO4j_icon             	Info.png
        _NEO4j_type         	HostMS
        _NEO4j_WF			        {}
        _NEO4J_RELATIONSHIP_RQD     No
}

